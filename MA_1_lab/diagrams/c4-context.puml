@startuml c4-context
!include <C4/C4_Context>

title C4, уровень 1: системный контекст сервиса объявлений

Person(client, "Пользователь", "Покупатель или продавец: роль зависит от объявления, один аккаунт на обе роли")
Person(moderator, "Модератор", "Разбирает жалобы, скрывает объявления, блокирует пользователей")

System(platform, "Сервис объявлений", "Пользователи, объявления и категории, поиск, избранное, чат, жалобы, уведомления")

System_Ext(comms, "Провайдеры связи", "e-mail, SMS, push (FCM, APNs)")
System_Ext(storage, "Объектное хранилище и CDN", "Хранение и раздача фотографий объявлений")

Rel(client, platform, "Ищет, публикует и редактирует объявления, избранное, чат, жалобы", "HTTPS, WebSocket")
Rel(moderator, platform, "Обрабатывает жалобы", "HTTPS")

Rel(platform, comms, "Отправляет уведомления", "HTTPS")
Rel(platform, storage, "Выдаёт ссылки для загрузки фото", "HTTPS")
Rel(client, storage, "Загружает и получает фото напрямую", "HTTPS")

SHOW_LEGEND()
@enduml
